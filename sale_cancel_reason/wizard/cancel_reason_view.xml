<?xml version="1.0" encoding="utf-8" ?>
<odoo>

<record id="sale_order_cancel_view_form" model="ir.ui.view">
    <field name="model">sale.order.cancel</field>
    <field name="inherit_id" ref="sale.sale_order_cancel_view_form" />
    <field name="arch" type="xml">

        <footer position="before">
            <field name="display_cancel_reason" invisible="1"/>
            <field name="allowed_reason_ids" invisible="1"/>
            <p class="oe_grey" attrs="{'invisible': [('display_cancel_reason', '=', False)]}">
                Choose the reason for the cancellation of the
                sale order.
            </p>
            <group>
                <field name="reason_id" widget="selection" attrs="{'invisible': [('display_cancel_reason', '=', False)]}" domain="[('id', 'in', allowed_reason_ids)]"/>
                <field name="need_description" invisible="1"/>
                <field name="reason_description" attrs="{'invisible': [('need_description', '=', False)], 'required': [('need_description', '=', True)]}"/>
            </group>
        </footer>

    </field>
</record>

</odoo>
